{
  "manager": {
    "log_level": "INFO",
    "enable_metrics": true,
    "metrics_interval": 30.0
  },
  "cameras": [
    {
      "camera_id": "front_door",
      "rtsp_url": "rtsp://192.168.0.219",
      "username": "service",
      "password": "WSS4Sec$$",
      "protocols": "tcp",
      "latency_ms": 150,
      "drop_on_latency": true,
      "target_fps": 12,
      "enable_display": true,
      "display_sync": false,
      "auto_reconnect": true,
      "max_reconnect_attempts": -1,
      "reconnect_initial_delay": 1.0,
      "reconnect_max_delay": 60.0,
      "reconnect_backoff_multiplier": 2.0,
      "health_check_interval": 5.0,
      "max_consecutive_errors": 5,
      "use_nvidia_decoder": true,
      "motion_detection": {
        "enabled": true,
        "algorithm": "MOG2_CUDA",
        "sensitivity": 0.5,
        "min_contour_area": 500,
        "max_contours": 50,
        "frame_skip": 2,
        "blur_size": 21,
        "history": 500,
        "var_threshold": 16.0,
        "detect_shadows": false,
        "cooldown_seconds": 1.0,
        "required_frames": 3,
        "max_frame_width": 640,
        "max_frame_height": 480
      },
      "face_detection": {
        "enabled": true,
        "model_path": "models/scrfd/scrfd_10g_bnkps.onnx",
        "input_size": 640,
        "confidence_threshold": 0.3,
        "nms_threshold": 0.4,
        "frame_skip": 3,
        "max_frame_width": 1280,
        "max_frame_height": 720,
        "min_face_size": 0.02,
        "max_faces": 20,
        "required_frames": 2,
        "cooldown_seconds": 2.0,
        "use_tensorrt": true,
        "use_cuda": true,
        "max_batch_size": 1,
        "save_faces": true,
        "save_path": "./face_crops",
        "save_margin": 0.3,
        "min_save_confidence": 0.4,
        "max_saves_per_event": 3
      }
    }
  ]
}
