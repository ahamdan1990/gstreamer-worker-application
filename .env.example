# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/camera_manager

# Redis
REDIS_URL=redis://localhost:6379/0

# API Settings
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
DEBUG=True
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# C++ Worker
WORKER_API_URL=http://localhost:8081

# CompreFace (optional - for future face recognition)
COMPREFACE_URL=http://localhost:8001
COMPREFACE_API_KEY=your-compreface-api-key

# Display (for live view)
DISPLAY=:0
