# Application
APP_NAME=GStreamer Camera Manager
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/camera_manager
DATABASE_ECHO=False

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# C++ Worker
WORKER_HOST=localhost
WORKER_PORT=8081
WORKER_API_URL=http://localhost:8081

# CompreFace
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=your-compreface-api-key

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
