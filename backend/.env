# Application
APP_NAME=GStreamer Camera Manager
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8002
API_PREFIX=/api/v1

# Database - PostgreSQL running on port 5433 (docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/camera_manager
DATABASE_ECHO=False

# Security
SECRET_KEY=dev-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8002"]

# C++ Worker - Auto-managed by FastAPI
WORKER_HOST=localhost
WORKER_PORT=8081
WORKER_API_URL=http://localhost:8081
WORKER_EXECUTABLE=../gstreamer_worker/build/gstreamer_worker_api
WORKER_AUTO_START=True
WORKER_AUTO_RESTART=True

# CompreFace - User's existing setup
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=

# Redis - User's existing container
REDIS_URL=redis://localhost:6379/0

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
